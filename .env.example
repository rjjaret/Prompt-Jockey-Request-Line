# Server
PORT=8000

# Collider API
# Transport mode: http (remote/local API) or defaults (macOS Collider desktop app)
COLLIDER_TRANSPORT=defaults

# HTTP mode settings
COLLIDER_BASE_URL=http://localhost:8080
# Optional for local Collider instances without auth
COLLIDER_API_TOKEN=
COLLIDER_CREATE_NODE_PATH=/api/nodes
COLLIDER_NODE_TYPE=prompt

# Desktop defaults mode settings
# Use a dedicated Collider variant bundle ID for SMS/node ingestion.
COLLIDER_BUNDLE_ID=com.google.promptjockeyrequestline
COLLIDER_PROMPT_KEY=Collider_Prompt

# Optional shared secret check for webhook requests
# WEBHOOK_SHARED_SECRET=replace-me
